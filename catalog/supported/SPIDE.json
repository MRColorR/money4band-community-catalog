{
  "name": "SPIDE",
  "dashboard": "https://spide.network/network.html",
  "compose_config": {
    "container_name": "${DEVICE_NAME}_spide",
    "hostname": "${DEVICE_NAME}_spide",
    "image": "xterna/spide-network",
    "environment": [
      "ID=${SPIDE_MACHINE_ID}"
    ],
    "labels": [
      "com.centurylinklabs.watchtower.enable=true",
      "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
    ],
    "restart": "always",
    "cpus": "${APP_CPU_LIMIT_MEDIUM}",
    "mem_reservation": "${APP_MEM_RESERV_MEDIUM}",
    "mem_limit": "${APP_MEM_LIMIT_MEDIUM}",
    "logging": {
      "driver": "json-file",
      "options": {
        "max-size": "10m",
        "max-file": "3"
      }
    },
    "healthcheck": {
      "test": [
        "CMD-SHELL",
        "pgrep -f spide || exit 1"
      ],
      "interval": "120s",
      "timeout": "10s",
      "retries": 3,
      "start_period": "60s"
    }
  },
  "compose_config_proxy": {
    "network_mode": "service:proxy",
    "hostname": null
  },
  "flags": {
    "machine_id": {
      "length": 32
    },
    "manual": {
      "instructions": "After starting the stack, open the Spide container logs and copy Device Key into Register Device at https://spide.network/network.html. Keep the machine ID saved in your Money4Band configuration to reuse the same device after container recreation. The device key and machine ID are different values."
    }
  },
  "install_limit": 1,
  "app_details": {
    "official_name": "Spide Network",
    "publisher": "Spide",
    "official_url": "https://spide.network",
    "tos_url": "https://spide.network/terms-of-use.html",
    "status": "active",
    "device_limits": {
      "max_devices_per_account": "unlimited",
      "max_devices_per_ip": 1,
      "max_ips_per_account": "unlimited",
      "notes": "Requires machine ID to regenerate device keys. Designed for multi-node deployments."
    },
    "ip_policy": {
      "residential": true,
      "datacenter": false,
      "vps": false,
      "vpn": false,
      "proxy": false,
      "mobile": true,
      "adjacent_ips_accepted": true,
      "adjacent_ips_max": "undocumented",
      "ipv6": "undocumented",
      "geo_restrictions": "none known",
      "quality_notes": "Official terms require residential IPs and prohibit servers, VPNs and proxy services."
    },
    "docker": {
      "image_official": false,
      "image_maintained": true,
      "last_update": "2024-10"
    },
    "earnings": {
      "model": "per-GB",
      "min_payout": "$5",
      "payout_methods": [
        "PayPal",
        "BTC"
      ],
      "avg_monthly_residential_usd": "unknown (early stage)",
      "avg_monthly_datacenter_usd": "unknown"
    },
    "confidence": "medium",
    "sources": [
      "https://spide.network/terms-of-use.html",
      "https://github.com/XternA/spide-network",
      "https://spide.network/network.html"
    ],
    "last_verified": "2026-03-23"
  },
  "referrals": [
    {
      "url": "https://spide.network/register.html?206a39",
      "contributor": "MRColorR"
    }
  ],
  "user_config_template": {
    "enabled": false,
    "machine_id": "yourSPIDEMachineID"
  },
  "profile": "residential"
}
