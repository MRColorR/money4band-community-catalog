{
  "name": "GRADIENT",
  "dashboard": "https://app.gradient.network/dashboard",
  "compose_config": {
    "container_name": "${DEVICE_NAME}_gradient",
    "hostname": "${DEVICE_NAME}_gradient",
    "image": "carbon2029/dockweb:latest",
    "environment": [
      "GRADIENT_EMAIL=$GRADIENT_EMAIL",
      "GRADIENT_PASS=$GRADIENT_PASSWORD"
    ],
    "labels": [
      "com.centurylinklabs.watchtower.enable=true",
      "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
    ],
    "volumes": [
      ".data/.gradient:/app/chrome_user_data"
    ],
    "restart": "always",
    "cpus": "${APP_CPU_LIMIT_BIG}",
    "mem_reservation": "${APP_MEM_RESERV_BIG}",
    "mem_limit": "${APP_MEM_LIMIT_BIG}",
    "logging": {
      "driver": "json-file",
      "options": {
        "max-size": "10m",
        "max-file": "3"
      }
    },
    "healthcheck": {
      "test": [
        "CMD-SHELL",
        "pgrep -f chrom || exit 1"
      ],
      "interval": "120s",
      "timeout": "10s",
      "retries": 5,
      "start_period": "90s"
    }
  },
  "compose_config_proxy": {
    "network_mode": "service:proxy",
    "hostname": null
  },
  "flags": {
    "email": {},
    "password": {}
  },
  "install_limit": 1,
  "compose_layer": "residential",
  "app_details": {
    "official_name": "Gradient",
    "publisher": "Gradient Network (Singapore)",
    "official_url": "https://gradient.network",
    "tos_url": "https://gradient.network/terms",
    "status": "deprecated",
    "device_limits": {
      "max_devices_per_account": "undocumented",
      "max_devices_per_ip": "undocumented",
      "max_ips_per_account": "undocumented",
      "notes": "Sentry Node beta has ended."
    },
    "ip_policy": {
      "residential": true,
      "datacenter": "partial",
      "vps": "partial",
      "vpn": false,
      "proxy": false,
      "mobile": "undocumented",
      "adjacent_ips_accepted": "undocumented",
      "adjacent_ips_max": "undocumented",
      "ipv6": "undocumented",
      "geo_restrictions": "none known",
      "quality_notes": "Sentry Node used residential browser connections."
    },
    "docker": {
      "image_official": false,
      "image_maintained": false,
      "last_update": "unknown"
    },
    "earnings": {
      "model": "points-based (Taps)",
      "min_payout": "Token airdrop pending",
      "payout_methods": [
        "undocumented"
      ],
      "avg_monthly_residential_usd": "unknown",
      "avg_monthly_datacenter_usd": "unknown"
    },
    "warnings": [
      "Unofficial Docker image.",
      "Sentry Node beta has ended."
    ],
    "confidence": "low",
    "sources": [
      "https://gradient.network",
      "https://docs.gradient.network/",
      "https://gradient.network/blog/parallax-the-sovereign-ai-os"
    ],
    "last_verified": "2026-03-21"
  },
  "referrals": [
    {
      "url": "https://app.gradient.network/signup?code=9WOBKP",
      "contributor": "MRColorR"
    }
  ],
  "user_config_template": {
    "enabled": false,
    "email": "yourGRADIENTMail",
    "password": "yourGRADIENTPw"
  },
  "additional_details": "Archived: Sentry Node beta has ended. The current product is Parallax."
}
