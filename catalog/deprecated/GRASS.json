{
  "name": "GRASS",
  "dashboard": "https://app.grass.io/dashboard",
  "compose_config": {
    "container_name": "${DEVICE_NAME}_grass",
    "hostname": "${DEVICE_NAME}_grass",
    "image": "ghcr.io/xterna/grass-node",
    "environment": [
      "USER_ID=$GRASS_USERID"
    ],
    "labels": [
      "com.centurylinklabs.watchtower.enable=true",
      "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
    ],
    "restart": "always",
    "cpus": "${APP_CPU_LIMIT_BIG}",
    "mem_reservation": "${APP_MEM_RESERV_BIG}",
    "mem_limit": "${APP_MEM_LIMIT_BIG}",
    "logging": {
      "driver": "json-file",
      "options": {
        "max-size": "10m",
        "max-file": "3"
      }
    }
  },
  "compose_config_proxy": {
    "network_mode": "service:proxy",
    "hostname": null
  },
  "flags": {
    "userid": {}
  },
  "install_limit": -1,
  "compose_layer": "residential",
  "app_details": {
    "official_name": "Grass (Wynd Network)",
    "publisher": "Wynd Network",
    "official_url": "https://www.grass.io/",
    "tos_url": "https://www.grass.io/terms-and-conditions/",
    "status": "deprecated",
    "device_limits": {
      "max_devices_per_account": "undocumented",
      "max_devices_per_ip": "undocumented",
      "max_ips_per_account": "undocumented",
      "notes": "Official desktop and browser-extension clients."
    },
    "ip_policy": {
      "residential": true,
      "datacenter": false,
      "vps": false,
      "vpn": false,
      "proxy": false,
      "mobile": "undocumented",
      "adjacent_ips_accepted": "undocumented",
      "adjacent_ips_max": "undocumented",
      "ipv6": "undocumented",
      "geo_restrictions": "none known",
      "quality_notes": "Residential connections only. VPNs and datacenter IPs are blocked."
    },
    "docker": {
      "image_official": false,
      "image_maintained": true,
      "last_update": "2025"
    },
    "earnings": {
      "model": "points -> GRASS token",
      "min_payout": "varies (token)",
      "payout_methods": [
        "GRASS token (crypto)"
      ],
      "avg_monthly_residential_usd": "unknown (token-based)",
      "avg_monthly_datacenter_usd": "N/A"
    },
    "warnings": [
      "Unofficial Docker image."
    ],
    "confidence": "medium",
    "sources": [
      "https://www.grass.io/",
      "https://grass-foundation.gitbook.io/grass-docs",
      "https://www.grass.io/terms-and-conditions/"
    ],
    "last_verified": "2026-03-21"
  },
  "referrals": [
    {
      "url": "https://app.grass.io/register?referralCode=qyvJmxgNUhcLo2f",
      "contributor": "MRColorR"
    }
  ],
  "additional_details": "Archived Docker integration. Install the official Grass app separately.",
  "user_config_template": {
    "enabled": false,
    "userid": "yourGRASSUserID"
  }
}
