{
  "name": "WIPTER",
  "dashboard": "https://wipter.com/dashboard",
  "compose_config": {
    "container_name": "${DEVICE_NAME}_wipter",
    "hostname": "${DEVICE_NAME}_wipter",
    "image": "ghcr.io/xterna/wipter",
    "environment": [
      "WIPTER_EMAIL=$WIPTER_EMAIL",
      "WIPTER_PASSWORD=$WIPTER_PASSWORD"
    ],
    "labels": [
      "com.centurylinklabs.watchtower.enable=true",
      "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
    ],
    "ports": [
      "${WIPTER_PORT_1}:5900",
      "${WIPTER_PORT_2}:6080"
    ],
    "restart": "always",
    "cpus": "${APP_CPU_LIMIT_MEDIUM}",
    "mem_reservation": "${APP_MEM_RESERV_MEDIUM}",
    "mem_limit": "${APP_MEM_LIMIT_MEDIUM}",
    "logging": {
      "driver": "json-file",
      "options": {
        "max-size": "10m",
        "max-file": "3"
      }
    }
  },
  "compose_config_proxy": {
    "network_mode": "service:proxy",
    "hostname": null,
    "ports": null
  },
  "flags": {
    "email": {},
    "password": {}
  },
  "install_limit": -1,
  "compose_layer": "residential",
  "app_details": {
    "official_name": "Wipter",
    "publisher": "Wipter",
    "official_url": "https://wipter.com",
    "tos_url": "https://wipter.com/en/terms-and-conditions-of-use",
    "status": "deprecated",
    "device_limits": {
      "max_devices_per_account": "undocumented",
      "max_devices_per_ip": "undocumented",
      "max_ips_per_account": "undocumented"
    },
    "ip_policy": {
      "residential": true,
      "datacenter": true,
      "vps": true,
      "vpn": "undocumented",
      "proxy": "undocumented",
      "mobile": true,
      "adjacent_ips_accepted": "undocumented",
      "adjacent_ips_max": "undocumented",
      "ipv6": "undocumented",
      "geo_restrictions": "undocumented",
      "quality_notes": "Residential, datacenter/hosting and mobile connections are eligible."
    },
    "docker": {
      "image_official": false,
      "image_maintained": false,
      "last_update": "unknown"
    },
    "earnings": {
      "model": "bandwidth sharing",
      "min_payout": "$20",
      "payout_methods": [
        "undocumented"
      ],
      "avg_monthly_residential_usd": "unknown",
      "avg_monthly_datacenter_usd": "unknown"
    },
    "warnings": [
      "High CPU and RAM usage.",
      "Unofficial Docker image."
    ],
    "confidence": "medium",
    "sources": [
      "https://wipter.com/en",
      "https://wipter.com/en/terms-and-conditions-of-use"
    ],
    "last_verified": "2026-03-21"
  },
  "referrals": [
    {
      "url": "https://wipter.com/signup?ref=money4band",
      "contributor": "MRColorR"
    }
  ],
  "additional_details": "Archived: excessive container resource usage.",
  "user_config_template": {
    "enabled": false,
    "email": "yourWIPTERMail",
    "password": "yourWIPTERPw",
    "ports": [
      5900,
      6080
    ]
  }
}
